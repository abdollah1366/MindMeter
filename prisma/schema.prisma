// پایگاه داده‌ی مایندمتر
// در توسعه از SQLite استفاده می‌شود. برای تولید، provider را به "postgresql" تغییر دهید
// و DATABASE_URL را تنظیم کنید.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// کاربران سایت: بیمار، متخصص (روانشناس/پزشک) و ادمین
model User {
  id          String    @id @default(cuid())
  phone       String    @unique /// شماره موبایل به فرم 09xxxxxxxxx
  /// PATIENT | PSYCHOLOGIST | PHYSICIAN | ADMIN
  role        String    @default("PATIENT")
  firstName   String?
  lastName    String?
  nationalId  String?   @unique /// کد ملی ۱۰ رقمی
  birthDate   DateTime?
  /// MALE | FEMALE | OTHER
  sex         String?
  education   String?
  city        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  results      TestResult[]
  clinician    ClinicianProfile?
  grants       AccessGrant[]     @relation("PatientGrants")
  notesAbout   ClinicalNote[]    @relation("PatientNotes")
  articles     Article[]         @relation("ArticleAuthor")
  appointments Appointment[]     @relation("PatientAppointments")
  payments     Payment[]
  referrals    Referral[]        @relation("PatientReferrals")
  enrollments  Enrollment[]
  certificates Certificate[]
  /// یادآوری پیامکی نوبت و کلاس‌ها
  smsReminders  Boolean            @default(true)
  notifications Notification[]
  pushSubs      PushSubscription[]
  uploads       Upload[]
}

/// کدهای یک‌بارمصرف ورود
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// نتیجه‌ی هر بار انجام تست
model TestResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testSlug  String
  /// پاسخ‌ها به صورت JSON: { "q1": 2, ... }
  answers   String
  /// امتیاز مقیاس‌ها به صورت JSON (محاسبه‌شده در سرور)
  scores    String
  /// هشدارهای ایمنی به صورت JSON
  alerts    String   @default("[]")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// پروفایل حرفه‌ای روانشناس / پزشک
model ClinicianProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PSYCHOLOGIST | PHYSICIAN
  kind            String
  /// عنوان نمایشی، مثلاً «دکتر» یا «کارشناس ارشد روانشناسی بالینی»
  title           String
  specialty       String
  /// شماره‌ی نظام روانشناسی یا نظام پزشکی
  licenseNumber   String
  bio             String   @default("")
  city            String?
  yearsExperience Int?
  /// PENDING | APPROVED | REJECTED
  status          String   @default("PENDING")
  reviewNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// تعرفه‌ی هر جلسه به تومان (۰ = رایگان)
  sessionPrice   Int     @default(0)
  /// مدت هر جلسه به دقیقه
  sessionMinutes Int     @default(45)
  acceptsOnline  Boolean @default(true)

  grants        AccessGrant[]
  notes         ClinicalNote[]
  availability  Availability[]
  appointments  Appointment[]
  referralsFrom Referral[]     @relation("ReferralFrom")
  referralsTo   Referral[]     @relation("ReferralTo")
  courses       Course[]
  /// عکس پروفایل (Upload با kind=AVATAR)
  avatarId      String?
  /// شماره‌ی شبا برای تسویه (IR + ۲۴ رقم) و نام صاحب حساب
  iban          String?
  ibanOwner     String?
  ledger        LedgerEntry[]
  payouts       Payout[]
}

/// اجازه‌ی بیمار به متخصص برای دیدن پرونده
model AccessGrant {
  id          String           @id @default(cuid())
  patientId   String
  patient     User             @relation("PatientGrants", fields: [patientId], references: [id], onDelete: Cascade)
  clinicianId String
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  revokedAt   DateTime?

  @@unique([patientId, clinicianId])
}

/// یادداشت بالینی متخصص درباره‌ی بیمار (فقط برای خود متخصص قابل مشاهده)
model ClinicalNote {
  id          String           @id @default(cuid())
  clinicianId String
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User             @relation("PatientNotes", fields: [patientId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime         @default(now())

  @@index([clinicianId, patientId])
}

/// مقاله‌های وبلاگ
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  /// متن مقاله؛ پاراگراف‌ها با یک خط خالی جدا می‌شوند و خطی که با ## شروع شود تیتر است
  body        String
  /// DRAFT | PUBLISHED
  status      String    @default("DRAFT")
  relatedTest String?
  authorId    String?
  author      User?     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// تنظیمات قابل تغییر هر تست توسط ادمین (محتوای سؤال‌ها در کد است)
model TestSetting {
  slug      String   @id
  enabled   Boolean  @default(true)
  featured  Boolean?
  updatedAt DateTime @updatedAt
}

/// ساعات کاری هفتگی متخصص (به وقت تهران)
model Availability {
  id          String           @id @default(cuid())
  clinicianId String
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  /// روز هفته: ۰ = شنبه ... ۶ = جمعه
  weekday     Int
  /// دقیقه از ابتدای روز، مثلاً ۹:۳۰ = ۵۷۰
  startMinute Int
  endMinute   Int

  @@index([clinicianId])
}

/// نوبت ویزیت آنلاین
model Appointment {
  id           String           @id @default(cuid())
  patientId    String
  patient      User             @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  clinicianId  String
  clinician    ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  /// PENDING_PAYMENT | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  status       String           @default("PENDING_PAYMENT")
  price        Int              @default(0)
  referralId   String?
  cancelReason String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime         @default(now())

  payments Payment[]
  signals  VisitSignal[]
  messages VisitMessage[]

  @@index([clinicianId, startsAt])
  @@index([patientId, startsAt])
}

/// پرداخت آنلاین
model Payment {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  enrollmentId  String?
  enrollment    Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  /// مبلغ به تومان
  amount        Int
  /// ZARINPAL | DEV
  provider      String
  authority     String?      @unique
  refId         String?
  /// PENDING | PAID | FAILED
  status        String       @default("PENDING")
  description   String
  createdAt     DateTime     @default(now())
  paidAt        DateTime?
}

/// ارجاع به مشاور یا متخصص دیگر
model Referral {
  id              String            @id @default(cuid())
  patientId       String
  patient         User              @relation("PatientReferrals", fields: [patientId], references: [id], onDelete: Cascade)
  /// متخصص ارجاع‌دهنده (اگر ارجاع از طرف متخصص باشد)
  fromClinicianId String?
  fromClinician   ClinicianProfile? @relation("ReferralFrom", fields: [fromClinicianId], references: [id], onDelete: SetNull)
  /// متخصص مقصد؛ خالی یعنی در صف عمومی تا یک متخصص بپذیرد
  toClinicianId   String?
  toClinician     ClinicianProfile? @relation("ReferralTo", fields: [toClinicianId], references: [id], onDelete: SetNull)
  resultId        String?
  /// PSYCHOLOGIST | PHYSICIAN | ANY
  preferredKind   String            @default("ANY")
  reason          String
  /// NEW | ACCEPTED | DECLINED | BOOKED | CLOSED
  status          String            @default("NEW")
  responseNote    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, toClinicianId])
}

/// پیام‌های سیگنالینگ WebRTC بین دو طرف ویزیت
model VisitSignal {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromUserId    String
  /// offer | answer | ice | hello | bye
  kind          String
  payload       String
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

/// چت داخل ویزیت
model VisitMessage {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  body          String
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

/// هنجار داخلی (رسمی) یک تست برای یک گروه سنی و جنسی؛ توسط ادمین ثبت می‌شود
model TestNorm {
  id        String   @id @default(cuid())
  testSlug  String
  /// کلید مقیاس، مثلاً total
  scaleKey  String   @default("total")
  /// ALL | MALE | FEMALE
  sex       String   @default("ALL")
  ageMin    Int
  ageMax    Int
  mean      Float
  sd        Float
  n         Int      @default(0)
  /// منبع: پژوهش هنجاریابی یا «شرکت‌کنندگان سایت تا تاریخ ...»
  source    String
  createdAt DateTime @default(now())

  @@index([testSlug, scaleKey])
}

// ─────────────── آکادمی ───────────────

/// دوره‌ی آموزشی (بسته‌ی درس‌ها)
model Course {
  id           String            @id @default(cuid())
  slug         String            @unique
  title        String
  /// توضیح کوتاه برای فهرست دوره‌ها
  summary      String
  /// توضیح کامل (همان قالب متن مقاله)
  description  String            @default("")
  /// مخاطب دوره، مثلاً «دانشجویان روانشناسی و عموم علاقه‌مندان»
  audience     String            @default("")
  /// BEGINNER | INTERMEDIATE | ADVANCED
  level        String            @default("BEGINNER")
  /// قیمت به تومان (۰ = رایگان)
  price        Int               @default(0)
  /// مدرس (متخصص تأییدشده)؛ خالی یعنی تیم آموزشی مایندمتر
  instructorId String?
  instructor   ClinicianProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  /// DRAFT | PUBLISHED
  status       String            @default("DRAFT")
  /// آیا پس از قبولی گواهی صادر شود
  certificate  Boolean           @default(true)
  /// حد نصاب قبولی آزمون پایانی (درصد)
  passingScore Int               @default(70)
  /// رنگ جلد: brand | calm | warm | rose | sky
  theme        String            @default("brand")
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  lessons      Lesson[]
  questions    CourseQuestion[]
  enrollments  Enrollment[]
  certificates Certificate[]
  coupons      Coupon[]
}

/// یک درس از دوره: ویدیو، متن یا کلاس زنده
model Lesson {
  id           String           @id @default(cuid())
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order        Int              @default(0)
  title        String
  /// VIDEO | TEXT | LIVE
  kind         String           @default("TEXT")
  /// لینک ویدیو: فایل mp4/m3u8 یا صفحه‌ی آپارات/یوتیوب
  videoUrl     String?
  /// متن درس یا جزوه‌ی همراه
  body         String           @default("")
  durationMin  Int              @default(0)
  /// پیش‌نمایش رایگان برای همه
  freePreview  Boolean          @default(false)
  /// زمان شروع کلاس زنده
  liveAt       DateTime?
  /// لینک ورود به کلاس زنده (اسکای‌روم، ادوبی کانکت، BigBlueButton، گوگل میت ...)
  liveUrl      String?
  createdAt    DateTime         @default(now())

  progress LessonProgress[]

  @@index([courseId, order])
}

/// ثبت‌نام کاربر در دوره
model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// PENDING_PAYMENT | ACTIVE | CANCELLED
  status      String    @default("PENDING_PAYMENT")
  /// مبلغ نهایی پس از تخفیف
  price       Int       @default(0)
  couponCode  String?
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  completedAt DateTime?

  progress     LessonProgress[]
  attempts     QuizAttempt[]
  payments     Payment[]
  certificate  Certificate?

  @@unique([userId, courseId])
}

/// درس‌های تمام‌شده
model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
}

/// سؤال آزمون پایان دوره (چهارگزینه‌ای)
model CourseQuestion {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int    @default(0)
  text     String
  /// گزینه‌ها به صورت JSON: ["...", "..."]
  options  String
  /// اندیس گزینه‌ی درست (از ۰)
  answer   Int

  @@index([courseId, order])
}

/// هر بار شرکت در آزمون پایانی
model QuizAttempt {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// پاسخ‌ها به صورت JSON: { "<questionId>": 2 }
  answers      String
  /// درصد پاسخ درست
  score        Int
  passed       Boolean
  createdAt    DateTime   @default(now())

  @@index([enrollmentId, createdAt])
}

/// گواهی پایان دوره با کد استعلام
model Certificate {
  id             String     @id @default(cuid())
  /// کد استعلام عمومی، مثلاً MM-7K3Q-9XPA
  code           String     @unique
  enrollmentId   String     @unique
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// نام‌ها هنگام صدور ثبت می‌شوند تا گواهی بعداً تغییر نکند
  fullName       String
  nationalId     String?
  courseTitle    String
  instructorName String
  hours          Int        @default(0)
  score          Int?
  issuedAt       DateTime   @default(now())
  /// ابطال توسط ادمین
  revokedAt      DateTime?
}

/// کد تخفیف دوره‌ها
model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  /// درصد تخفیف ۱ تا ۱۰۰
  percent   Int
  /// خالی یعنی برای همه‌ی دوره‌ها
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  maxUses   Int?
  used      Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// ─────────────── آمار سایت ───────────────

/// بازدید صفحه یا رویداد، بدون کوکی و بدون ذخیره‌ی IP.
/// visitor هش روزانه‌ی IP و مرورگر با یک نمک مخفی است؛ فردا همان بازدیدکننده هش دیگری دارد.
model PageView {
  id        String   @id @default(cuid())
  /// view | test_start | test_complete | signup | enroll
  kind      String   @default("view")
  path      String
  /// دامنه‌ی ارجاع‌دهنده، مثلاً google.com (خالی = مستقیم یا داخلی)
  referrer  String?
  visitor   String
  /// mobile | desktop | tablet
  device    String   @default("desktop")
  /// برای رویدادها: slug تست یا دوره
  ref       String?
  /// utm_source اگر وجود داشته باشد
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([path, createdAt])
}

// ─────────────── اعلان‌ها، یادآوری، سوابق دسترسی، فایل‌ها ───────────────

/// اعلان داخل سایت (و همان متنی که با Push/پیامک فرستاده می‌شود)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// اشتراک Push مرورگر
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// جلوگیری از ارسال تکراری یادآوری
model ReminderLog {
  id       String   @id @default(cuid())
  /// APPT_24H | APPT_1H | LIVE_24H | LIVE_1H
  kind     String
  targetId String
  userId   String
  sentAt   DateTime @default(now())

  @@unique([kind, targetId, userId])
}

/// سوابق دسترسی و تغییرات حساس (چه کسی، چه زمانی، چه چیزی)
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// مثلاً record.view، report.view، role.change، clinician.review
  action     String
  targetType String?
  targetId   String?
  /// بیماری که پرونده‌اش دیده یا تغییر داده شده (برای نمایش به خود بیمار)
  patientId  String?
  /// جزئیات به صورت JSON
  meta       String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// فایل آپلودشده؛ خود فایل در پوشه‌ی UPLOAD_DIR است، نه در پایگاه داده
model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// AVATAR (عمومی) | DOCUMENT (فقط صاحب و ادمین) | CHAT (دو طرف ویزیت)
  kind      String
  /// برای CHAT: شناسه‌ی نوبت
  scopeId   String?
  name      String
  mime      String
  size      Int
  /// نام فایل روی دیسک
  storedAs  String   @unique
  createdAt DateTime @default(now())

  @@index([ownerId, kind])
}

// ─────────────── کیف پول متخصص و تسویه ───────────────

/** تنظیمات قابل تغییر سایت (کلید/مقدار) */
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * دفتر حساب متخصص. مبلغ به تومان و علامت‌دار است: درآمد مثبت، برداشت منفی.
 * موجودی = جمع همه‌ی ردیف‌ها.
 */
model LedgerEntry {
  id           String           @id @default(cuid())
  clinicianId  String
  clinician    ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  /// VISIT | COURSE | PAYOUT | PAYOUT_REVERSAL | ADJUSTMENT
  kind         String
  amount       Int
  /// مبلغ کل پرداختی مشتری و کمیسیون سایت (برای گزارش)
  gross        Int              @default(0)
  commission   Int              @default(0)
  /// شناسه‌ی منبع (نوبت، ثبت‌نام یا درخواست تسویه) برای جلوگیری از ثبت تکراری
  sourceId     String?
  note         String           @default("")
  createdAt    DateTime         @default(now())

  @@unique([kind, sourceId])
  @@index([clinicianId, createdAt])
}

/** درخواست تسویه */
model Payout {
  id          String           @id @default(cuid())
  clinicianId String
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  amount      Int
  iban        String
  ibanOwner   String
  /// REQUESTED | PAID | REJECTED
  status      String           @default("REQUESTED")
  /// شماره‌ی پیگیری بانکی
  reference   String?
  note        String?
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?

  @@index([status, createdAt])
}
