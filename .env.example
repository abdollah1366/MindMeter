# پایگاه داده (SQLite برای توسعه)
DATABASE_URL="file:./dev.db"

# کلید امضای نشست کاربر؛ یک رشته‌ی تصادفی طولانی (مثلاً: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# پیامک کاوه‌نگار (اختیاری در توسعه؛ اگر خالی باشد کد ورود در ترمینال چاپ می‌شود)
KAVENEGAR_API_KEY=""
# نام قالب «تأیید» تعریف‌شده در پنل کاوه‌نگار که یک توکن (%token) دارد
KAVENEGAR_OTP_TEMPLATE=""

# کد ورود ثابت برای توسعه تا وقتی پیامک وصل نشده (در حالت production یا با تنظیم کاوه‌نگار نادیده گرفته می‌شود)
DEV_OTP_CODE="12345"

# شماره موبایل ادمین‌ها، جدا با کاما. این کاربران هنگام ورود نقش ADMIN می‌گیرند
ADMIN_PHONES="09121234567"

# درگاه پرداخت زرین‌پال. اگر خالی باشد در حالت توسعه «پرداخت آزمایشی» نمایش داده می‌شود (در production الزامی است)
ZARINPAL_MERCHANT_ID=""
# برای تست با سندباکس زرین‌پال "true" بگذارید
ZARINPAL_SANDBOX="false"

# سرورهای STUN/TURN برای ویزیت آنلاین (JSON). خالی = STUN عمومی گوگل.
# برای اتصال پایدار در ایران یک TURN server (مثلاً coturn روی سرور داخلی) لازم است، مثلاً:
# ICE_SERVERS='[{"urls":"stun:turn.mindmeter.ir:3478"},{"urls":"turn:turn.mindmeter.ir:3478","username":"mm","credential":"secret"}]'
ICE_SERVERS=""
